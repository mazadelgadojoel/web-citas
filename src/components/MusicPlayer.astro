---
interface Props {
  position?: 'bottom-right' | 'bottom-left';
}

const { position = 'bottom-right' } = Astro.props;
---

<div
  id="music-player"
  class="fixed z-40 flex items-center gap-2"
  style={`${position === 'bottom-right' ? 'right: 16px' : 'left: 16px'}; bottom: 16px`}
>
  <button
    id="music-btn"
    type="button"
    aria-label="Reproducir música"
    class="w-[52px] h-[52px] rounded-full bg-gradient-to-br from-primary to-rose text-white shadow-lg shadow-primary/30 flex items-center justify-center transition-transform duration-300 hover:scale-110"
  >
    <span id="music-icon-play" class="material-symbols-outlined" style="font-size: 26px">music_note</span>
    <span id="music-icon-pause" class="material-symbols-outlined hidden" style="font-size: 26px">pause</span>
  </button>
  <span
    id="music-note-float"
    class="material-symbols-outlined text-primary animate-bounce"
    style="font-size: 22px; animation-duration: 1.4s"
  >music_note</span>
</div>

<script>
  let ctx: AudioContext | null = null;
  let gain: GainNode | null = null;
  let playing = false;
  let timer: ReturnType<typeof setInterval> | null = null;

  const playIcon = document.getElementById('music-icon-play');
  const pauseIcon = document.getElementById('music-icon-pause');

  // Melodía romántica original (notas / frecuencias Hz)
  // Escala en La menor con toques dulces, tempo lento estilo piano
  const NOTES: Array<[number, number, number]> = [
    // [frecuencia, duración (seg), exponente de retardo]
    [440, 0.5, 0], // La4
    [523.25, 0.5, 0], // Do5
    [659.25, 0.5, 0], // Mi5
    [523.25, 0.5, 0],
    [493.88, 0.75, 0], // Si4
    [440, 0.5, 0], // La4
    [392, 0.5, 0], // Sol4
    [440, 0.75, 0], // La4
    [587.33, 0.5, 0], // Re5
    [659.25, 0.5, 0], // Mi5
    [698.46, 0.75, 0], // Fa5
    [659.25, 0.5, 0],
    [523.25, 0.5, 0],
    [440, 0.75, 0],
    [392, 0.5, 0], // Sol4
    [440, 1, 0], // La4 (final frase)
    // vuelta
    [587.33, 0.5, 0],
    [659.25, 0.5, 0],
    [783.99, 0.5, 0], // Sol5
    [880, 0.75, 0], // La5
    [783.99, 0.5, 0],
    [659.25, 0.5, 0],
    [698.46, 0.75, 0],
    [659.25, 0.5, 0],
    [587.33, 0.5, 0],
    [523.25, 0.75, 0],
    [493.88, 0.5, 0],
    [440, 1.25, 0],
  ];

  function note(freq: number, start: number, dur: number, vol: number) {
    if (!ctx || !gain) return;
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freq;
    const t0 = ctx.currentTime + start;
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.linearRampToValueAtTime(vol, t0 + 0.05);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    osc.connect(g);
    g.connect(gain);
    osc.start(t0);
    osc.stop(t0 + dur + 0.1);
  }

  function schedule() {
    if (!ctx || !gain) return;
    let t = 0;
    NOTES.forEach(([f, d]) => {
      note(f, t, d, 0.28);
      // un acorde suave una octava abajo en notas largas
      if (d >= 0.75) note(f / 2, t, d, 0.1);
      t += d;
    });
    // loop: reprogramar al final del ciclo (duración total del arreglo)
    const total = NOTES.reduce((acc, [, d]) => acc + d, 0);
    timer = setTimeout(schedule, (total - 0.2) * 1000);
  }

  const btn = document.getElementById('music-btn') as HTMLButtonElement;

  btn.addEventListener('click', () => {
    if (!ctx) {
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      gain = ctx.createGain();
      gain.gain.value = 0.9;
      gain.connect(ctx.destination);
    }
    if (ctx.state === 'suspended') ctx.resume();

    if (playing) {
      stop();
    } else {
      playing = true;
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
      schedule();
    }
  });

  function stop() {
    playing = false;
    if (timer) clearTimeout(timer);
    playIcon.classList.remove('hidden');
    pauseIcon.classList.add('hidden');
  }
</script>
