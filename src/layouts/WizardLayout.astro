---
import '../styles/global.css';
import MusicPlayer from '../components/MusicPlayer.astro';

interface Props {
  title: string;
  progress?: number;
  showBrand?: boolean;
}

const { title, progress = 0, showBrand = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Dancing+Script:wght@500;600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,500;1,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background text-on-surface font-body-md min-h-screen relative overflow-x-hidden antialiased"
    style="background-image:
      radial-gradient(ellipse at 15% 10%, rgba(217,108,108,0.12), transparent 50%),
      radial-gradient(ellipse at 85% 20%, rgba(255,194,168,0.14), transparent 55%),
      radial-gradient(ellipse at 50% 95%, rgba(255,186,190,0.12), transparent 55%)"
  >
    {progress > 0 && (
      <div class="fixed top-0 left-0 w-full h-1.5 bg-rose/20 z-50">
        <div
          class="h-full bg-gradient-to-r from-primary to-rose rounded-r-full progress-fill"
          style={`width: ${progress}%; --progress: ${progress}%`}
        />
      </div>
    )}

    {showBrand && progress > 0 && (
      <header
        class="fixed top-0 w-full z-40 flex items-center justify-between px-gutter h-[60px] max-w-container-max mx-auto left-1/2 -translate-x-1/2"
      >
        <a href="/" class="font-script text-[26px] leading-none text-primary">
          Para ti &nbsp;♡
        </a>
        <span class="text-primary material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">favorite</span>
      </header>
    )}

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
      <div
        class="absolute -top-24 -right-16 w-[420px] h-[420px] rounded-full opacity-70"
        style="background: radial-gradient(circle, rgba(255,217,208,0.55), transparent 65%)"
      ></div>
      <div
        class="absolute -bottom-28 -left-20 w-[460px] h-[460px] rounded-full opacity-70"
        style="background: radial-gradient(circle, rgba(255,216,222,0.5), transparent 65%)"
      ></div>
    </div>

    <slot />
    <MusicPlayer />
  </body>
</html>
