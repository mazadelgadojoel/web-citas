---
import WizardLayout from '../layouts/WizardLayout.astro';
---

<WizardLayout title="Resumen de nuestra cita" progress={100}>
  <main class="w-full max-w-container-max relative z-10 min-h-screen flex flex-col items-center justify-center py-section-gap px-gutter">
    <div class="letter-card rounded-[20px] p-8 md:p-12 shadow-sm flex flex-col items-center text-center space-y-10 relative overflow-hidden w-full">
      <div class="absolute top-[-50px] right-[-50px] w-32 h-32 bg-primary-container/20 rounded-full blur-[40px] pointer-events-none"></div>
      <div class="absolute bottom-[-50px] left-[-50px] w-40 h-40 bg-secondary-container/20 rounded-full blur-[40px] pointer-events-none"></div>

      <div class="wax-seal">
        <span class="material-symbols-outlined">favorite</span>
      </div>

      <div class="space-y-4">
        <span class="inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-primary-container/60 text-primary font-label-sm text-label-sm uppercase tracking-[0.2em] border border-primary/20">
          Resumen ✨
        </span>
        <h1 class="font-script text-script-2xl sm:text-script-3xl text-on-surface leading-[1.15] mt-2">
          ¡Todo listo para
          <em class="block text-primary">nuestro plan! 💌</em>
        </h1>
        <span class="heart-divider mb-2">♡</span>
        <p id="subtitle" class="font-body-lg text-body-lg text-on-surface-variant/80 max-w-md mx-auto">
          He preparado algo especial basado en tus elecciones. 🤍
        </p>
      </div>

      <div class="w-full grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="glass-card rounded-xl p-6 flex flex-col items-center justify-center">
          <div class="w-12 h-12 rounded-full bg-primary-container/20 flex items-center justify-center text-primary mb-3">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">place</span>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant/60 uppercase mb-1">Plan</span>
          <h3 id="summary-place" class="font-headline-md text-[15px] leading-tight text-on-surface">—</h3>
          <a id="maps-link" class="hidden mt-2 text-sm text-primary" target="_blank" rel="noopener noreferrer">Ver en Maps</a>
        </div>
        <div class="glass-card rounded-xl p-6 flex flex-col items-center justify-center" id="genre-card">
          <div class="w-12 h-12 rounded-full bg-tertiary-container/20 flex items-center justify-center text-tertiary mb-3">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">movie</span>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant/60 uppercase mb-1">Cine</span>
          <h3 id="summary-genre" class="font-headline-md text-[15px] leading-tight text-on-surface">—</h3>
        </div>
        <div class="glass-card rounded-xl p-6 flex flex-col items-center justify-center">
          <div class="w-12 h-12 rounded-full bg-secondary-container/20 flex items-center justify-center text-secondary mb-3">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calendar_today</span>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant/60 uppercase mb-1">Día</span>
          <h3 id="summary-day" class="font-headline-md text-[15px] leading-tight text-on-surface">—</h3>
        </div>
        <div class="glass-card rounded-xl p-6 flex flex-col items-center justify-center">
          <div class="w-12 h-12 rounded-full bg-rose/20 flex items-center justify-center text-rose mb-3">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">schedule</span>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant/60 uppercase mb-1">Hora</span>
          <h3 id="summary-time" class="font-headline-md text-[15px] leading-tight text-on-surface">—</h3>
        </div>
      </div>

      <p id="summary-logistics" class="font-body-md text-on-surface-variant"></p>

      <div class="w-full space-y-6 pt-4 border-t border-white/20">
        <p class="font-body-md text-body-md text-on-surface-variant italic">
          "Presiona el botón para enviarme tu respuesta mágica."
        </p>
        <a
          id="wa-btn"
          href="#"
          class="w-full md:w-auto mx-auto inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-primary to-rose text-white rounded-full font-headline-md text-[18px] shadow-lg shadow-primary/30 hover:-translate-y-1 hover:shadow-primary/50 transition-all duration-300 min-h-touch-target"
        >
          <span class="mr-2">Enviar a WhatsApp</span> 💌
        </a>
      </div>
    </div>
  </main>
</WizardLayout>

<script>
  import { WHATSAPP_NUMBER } from '../data/config';
  import { buildWhatsAppUrl, requireFields } from '../lib/wizard';

  const state = requireFields(['place', 'day', 'time', 'logistics'], '/horario');
  const number = WHATSAPP_NUMBER;

  const subtitle = document.getElementById('subtitle');
  const placeEl = document.getElementById('summary-place');
  const genreEl = document.getElementById('summary-genre');
  const genreCard = document.getElementById('genre-card');
  const dayEl = document.getElementById('summary-day');
  const timeEl = document.getElementById('summary-time');
  const logisticsEl = document.getElementById('summary-logistics');
  const mapsLink = document.getElementById('maps-link') as HTMLAnchorElement;
  const waBtn = document.getElementById('wa-btn') as HTMLAnchorElement;

  if (subtitle) subtitle.textContent = `He preparado algo especial para ti 🤍`;
  if (placeEl) placeEl.textContent = state.place;
  if (dayEl) dayEl.textContent = state.day;
  if (timeEl) timeEl.textContent = state.timeLabel || state.time;
  if (logisticsEl) logisticsEl.textContent = state.notes ? `${state.logistics}. ${state.notes}` : state.logistics;

  if (state.genre) {
    if (genreEl) genreEl.textContent = state.genre;
  } else {
    genreCard?.classList.add('hidden');
  }

  if (state.maps && mapsLink) {
    mapsLink.href = state.maps;
    mapsLink.classList.remove('hidden');
  }

  waBtn.href = buildWhatsAppUrl(number, state);
  waBtn.target = '_blank';
  waBtn.rel = 'noopener noreferrer';

  const createHeart = () => {
    const heart = document.createElement('div');
    heart.classList.add('floating-heart');
    heart.innerHTML = '🤍';
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.animationDuration = `${Math.random() * 3 + 3}s`;
    heart.style.fontSize = `${Math.random() * 10 + 10}px`;
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 5000);
  };

  setInterval(createHeart, 2000);
</script>
