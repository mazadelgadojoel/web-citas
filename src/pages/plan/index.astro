---
import WizardLayout from '../../layouts/WizardLayout.astro';
import { categorias } from '../../data/destinos';
---

<WizardLayout title="Proposal ✨ - El plan" progress={25}>
  <main class="flex-1 flex flex-col items-center justify-center pt-24 pb-16 px-gutter min-h-screen">
    <div class="w-full max-w-container-max mx-auto relative">
      <div class="letter-card rounded-[20px] p-8 relative z-10">
        <div class="flex flex-col items-center text-center mb-8">
          <h1 class="font-script text-script-2xl sm:text-script-3xl text-on-surface leading-[1.15] mb-3">
            ¿Qué quisieras
            <em class="block text-primary">hacer?</em>
          </h1>
          <span class="heart-divider mb-4">♡</span>
          <p class="font-body-md text-body-md text-on-surface-variant">Elige el plan perfecto para nosotros ✨</p>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-8" id="category-grid">
          {categorias.map((cat) => (
            <button
              type="button"
              class="glass-option rounded-2xl p-6 flex flex-col items-center justify-center gap-3 w-full"
              data-slug={cat.slug}
              data-nombre={cat.nombre}
            >
              <span class="text-4xl drop-shadow-sm">{cat.emoji}</span>
              <span class="font-body-md text-body-md text-on-surface">{cat.nombre}</span>
            </button>
          ))}
          <button
            type="button"
            class="glass-option rounded-2xl p-6 flex flex-col items-center justify-center gap-3 w-full col-span-2"
            data-slug="custom"
            data-nombre="Tengo otra idea"
          >
            <span class="text-4xl">✨</span>
            <span class="font-body-md text-body-md text-on-surface">Tengo otra idea</span>
          </button>
        </div>

        <div id="custom-box" class="hidden mb-8">
          <label class="sr-only" for="custom-idea">Tu idea</label>
          <input id="custom-idea" class="input-line text-left" type="text" placeholder="Cuéntame tu idea..." />
        </div>

        <button class="btn-primary" id="continue-btn" disabled>Continuar ✨</button>
      </div>
    </div>
  </main>
</WizardLayout>

<script>
  import { KEYS, setField } from '../../lib/wizard';

  const cards = document.querySelectorAll<HTMLButtonElement>('#category-grid button');
  const continueBtn = document.getElementById('continue-btn') as HTMLButtonElement;
  const customBox = document.getElementById('custom-box') as HTMLDivElement;
  const customInput = document.getElementById('custom-idea') as HTMLInputElement;

  let selected = '';

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      cards.forEach((c) => c.classList.remove('selected'));
      card.classList.add('selected');
      selected = card.dataset.slug ?? '';
      customBox.classList.toggle('hidden', selected !== 'custom');
      continueBtn.disabled = false;
    });
  });

  continueBtn.addEventListener('click', () => {
    if (!selected) return;

    if (selected === 'custom') {
      const idea = customInput.value.trim();
      if (!idea) {
        customInput.focus();
        return;
      }
      setField(KEYS.category, 'custom');
      setField(KEYS.place, idea);
      setField(KEYS.maps, '');
      setField(KEYS.genre, '');
      window.location.href = '/horario';
      return;
    }

    setField(KEYS.category, selected);
    setField(KEYS.place, '');
    setField(KEYS.maps, '');
    setField(KEYS.genre, '');

    if (selected === 'cines') {
      window.location.href = '/cine';
      return;
    }

    window.location.href = `/plan/${selected}`;
  });
</script>
