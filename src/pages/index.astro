---
import WizardLayout from '../layouts/WizardLayout.astro';
---

<WizardLayout title="Proposal ✨" progress={0} showBrand={false}>

  <main class="w-full max-w-container-max px-gutter relative z-10 flex flex-col items-center min-h-screen justify-center py-10">
    <div class="letter-card w-full p-8 sm:p-12 flex flex-col items-center text-center">
      <div class="wax-seal mb-6">
        <span class="material-symbols-outlined">favorite</span>
      </div>

      <p class="font-label-sm text-label-sm text-primary uppercase tracking-[0.25em] mb-2">
        Para ti, con cariño
      </p>

      <span class="heart-divider mb-4">♡</span>

      <h1 class="font-script text-script-2xl sm:text-script-3xl text-on-surface leading-[1.15] mb-4">
        Tengo una pregunta
        <em class="block text-primary">muy importante...</em>
      </h1>

      <!-- Pregunta: ¿Saldrías conmigo? -->
      <section id="step-question" class="w-full max-w-sm">
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-3">
          Es corta, te lo prometo ✨
        </p>
        <h2 class="font-script text-script-2xl text-primary leading-[1.15] mb-3">
          ¿Saldrías conmigo?
        </h2>
        <span class="heart-divider mb-6">💗</span>

        <div class="flex items-center justify-center gap-4 min-h-[64px] flex-wrap" id="answers">
          <button class="answer-btn btn-yes" id="btn-yes" type="button">¡Sí, obvio! ❤️</button>
          <button class="answer-btn btn-no" id="btn-no" type="button">No se 🙈</button>
        </div>

        <p id="yes-msg" class="hidden mt-6 font-script text-script-xl text-primary">
          ¡Yupi! Sabía que dirías que sí 💖
        </p>
      </section>
    </div>
  </main>
</WizardLayout>

<script>
  const btnYes = document.getElementById('btn-yes') as HTMLButtonElement;
  const btnNo = document.getElementById('btn-no') as HTMLButtonElement;
  const yesMsg = document.getElementById('yes-msg') as HTMLElement;

  const emojis = ['🤍', '💗', '🩷', '💖', '💝', '🌸'];

  function spawnHeart() {
    const heart = document.createElement('div');
    heart.classList.add('floating-heart');
    heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.animationDuration = `${Math.random() * 3 + 4}s`;
    heart.style.fontSize = `${Math.random() * 12 + 12}px`;
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 7000);
  }

  setInterval(spawnHeart, 1800);

  btnYes.addEventListener('click', () => {
    yesMsg.classList.remove('hidden');
    btnYes.disabled = true;
    setTimeout(() => {
      window.location.href = '/plan';
    }, 1200);
  });

  btnNo.addEventListener('click', (e) => {
    e.preventDefault();
    dodge(btnNo);
  });
  btnNo.addEventListener('mouseenter', () => dodge(btnNo));
  btnNo.addEventListener('touchstart', () => dodge(btnNo));

  function dodge(el: HTMLElement) {
    const wrap = el.closest('.flex') as HTMLElement;
    const maxX = wrap.clientWidth - el.offsetWidth;
    const maxY = 60;
    const x = Math.random() * maxX;
    const yPos = (Math.random() * 2 - 1) * maxY;
    el.style.transform = `translate(${x - el.offsetLeft}px, ${yPos}px)`;
    el.style.transition = 'transform 0.18s ease';
  }
</script>

<style>
  .answer-btn {
    @apply font-headline-md text-[16px] px-6 py-3 rounded-full transition-all duration-200 min-h-touch-target;
  }
  .btn-yes {
    @apply bg-gradient-to-r from-primary to-rose text-white shadow-lg shadow-primary/30;
  }
  .btn-yes:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 14px 34px -8px rgba(176, 58, 72, 0.55);
  }
  .btn-no {
    @apply bg-white text-on-surface-variant border border-outline-variant;
  }
  .btn-no:active {
    @apply opacity-70;
  }
</style>
